# Required at build time for client-side YouTube Data API v3 metadata lookup.
YOUTUBE_API_KEY=

# Public origin used to derive WebAuthn RPID, RPOrigins, session cookie flags,
# and generated invite URLs. WebAuthn RPID requires a domain name (not an IP literal).
# Production under cubus.sh: https://audown.cubus.sh
# Standalone local dev: http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Standalone local PostgreSQL DSN (used only when DB_BROKER_URL is unset).
# Production under cubus.sh injects DB_BROKER_URL from root docker-compose.yml.
DATABASE_URL=postgresql://dev:dev@postgres:5432/dev?sslmode=disable

# Optional (admin.cubus.sh): set a random Bearer token (>= 16 bytes, not a
# replace-with-* placeholder) to enable the internal-only :9090 Admin API.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# ADMIN_API_TOKEN=replace-with-a-random-admin-api-token
