# Required at build time for client-side YouTube Data API v3 metadata lookup.
YOUTUBE_API_KEY=

# Optional (admin.cubus.sh): set a random Bearer token (>= 16 bytes, not a
# replace-with-* placeholder) to enable the internal-only :9090 Admin API.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# ADMIN_API_TOKEN=replace-with-a-random-admin-api-token
